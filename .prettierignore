# Build output
.aws-sam/
coverage/

# Lockfile is npm's to format
package-lock.json

# Personal settings; ignored via global gitignore for some devs, so pin it here
# to keep `format:check` consistent between local runs and CI.
.claude/settings.local.json

# CloudFormation/SAM convention is 2-space indent and double quotes, which is
# what every AWS doc and generator emits. Reformatting to this repo's 4-space
# JS style rewrites the whole file and destroys blame on the infra that matters
# most. Correctness here is cfn-lint's job (`sam validate --lint`), not Prettier's.
template.yaml
infra/*.yaml
