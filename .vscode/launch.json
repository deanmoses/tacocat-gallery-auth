{
    "configurations": [
        {
            "type": "aws-sam",
            "request": "direct-invoke",
            "name": "Run Login Redirect",
            "invokeTarget": {
                "target": "template",
                "templatePath": "${workspaceFolder}/template.yaml",
                "logicalId": "RedirectToCognitoFunction"
            },
            "lambda": {
                "runtime": "nodejs24.x"
            }
        },
        {
            "type": "aws-sam",
            "request": "direct-invoke",
            "name": "Run AuthStatusFunction via API",
            "invokeTarget": {
                "target": "api",
                "templatePath": "${workspaceFolder}/template.yaml",
                "logicalId": "AuthStatusFunction"
            },
            "api": {
                "path": "/",
                "httpMethod": "get"
            }
        },
        {
            "name": "Attach to SAM CLI",
            "type": "node",
            "request": "attach",
            "address": "localhost",
            "port": 9999,
            "localRoot": "${workspaceRoot}/src",
            "remoteRoot": "/var/task",
            "protocol": "inspector",
            "stopOnEntry": false
        }
    ]
}
